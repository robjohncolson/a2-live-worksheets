{
  "//": "TYPECHECK_HARDENING_SPEC.md P2 — checker only, no emit. Tight allowlist: the",
  "// ": "root receipt browser modules + shared JSDoc contracts.",
  "//  ": "`// @ts-check` opts each in (checkJs off), so anything outside the list is",
  "//   ": "loaded for types but never error-reported. NOT on the Pages/Vercel path.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "types/globals.d.ts",
    "types/contracts.js",
    "receipt-sign.js",
    "receipt-verify.js",
    "ledger-store.js",
    "ledger-seal.js",
    "submission-store.js",
    "submission-grader.js",
    "gradebook-client.js"
  ]
}
