ROSTER_SUPABASE_URL=          # existing shared Supabase project; isolate every A2 table in schema a2
ROSTER_SUPABASE_SERVICE_KEY=  # service-role key, SERVER ONLY, never shipped to a client
ROSTER_TOKEN_SECRET=          # long random string for HMAC (e.g. openssl rand -hex 32)
ROSTER_TEACHER_SECRET=        # shared secret the teacher uses to enroll students
TEACHER_KEY=                  # teacher authorization; configure for the A2 deployment
PORT=8090
ROSTER_PROCTOR_SECRET=        # gates evidence_tier=proctored writes (L-C); never client-side
WORK_MANIFEST_PATH=           # path to data/work-manifest.json (default: repo data dir)
ROSTER_PW_ENC_KEY=            # TR1: AES-256-GCM key for teacher-recoverable passwords.
                              # openssl rand -hex 32. SERVER ONLY, never client/git.
                              # Rotating it makes existing password_cipher unreadable
                              # (logins still work; each re-encrypts on next change).

# District 50/40/10 is ON by default and takes precedence over v3.
USE_DISTRICT_FORMULA=true
USE_V3_GRADING=false

# Set the A2 enrollment sections when deploying the isolated service.
OPEN_SIGNUP_SECTIONS="PeriodC:Section C;PeriodD:Section D;PeriodG:Section G"

# Required schema isolation. Never use public.
ROSTER_DB_SCHEMA=a2
# Comma-separated ORIGINS, without paths or trailing slashes. Update Vercel URL.
CORS_ORIGINS=https://a2-live-worksheets.vercel.app,https://robjohncolson.github.io,http://localhost:8080,http://localhost:8091
# Ed25519 PKCS8 DER, base64. See deploy/RUNBOOK.md for a portable generator.
RECEIPT_ISSUER_PRIVATE_KEY=
