# Cloudflare R2 upload credentials for scripts/upload-r2.mjs (ANDROID Phase 5).
# COPY this file to `.r2.env` (which is gitignored) and fill in your R2 API token.
# Create the token in Cloudflare: R2 → "Manage R2 API Tokens" → Create → Object Read & Write.
# The secret stays ONLY in your local .r2.env — never commit it, never paste it in chat.

R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Endpoint + bucket are baked into the script (not secret); uncomment to override:
# R2_ENDPOINT=https://e6c057c6ab5a5845b39d233735c83ec1.r2.cloudflarestorage.com
# R2_BUCKET=apstats
